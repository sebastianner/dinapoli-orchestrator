{
  "name": "dinapoli-orchestrator",
  "version": "1.0.0",
  "description": "Dinapoli Pizza order orchestrator: WS order intake, persistent print queue, billing and payment.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/assets','dist/assets',{recursive:true})\"",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/migrate.ts --reset && tsx src/db/seed.ts",
    "test": "tsx tests/run-all.ts",
    "test:stress": "tsx tests/run-all.ts --stress",
    "test:print-blocking": "tsx tests/run-all.ts --print-blocking",
    "ws:client": "tsx scripts/test-order-client.ts",
    "ws:simulate": "tsx scripts/simulate-orders.ts",
    "ws:stress": "tsx scripts/stress-test-orders.ts",
    "orders:complete-random": "tsx scripts/complete-random-orders.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "gdrive:auth": "tsx scripts/google-drive-auth.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.9.1",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "googleapis": "^173.0.0",
    "jsonwebtoken": "^9.0.3",
    "pngjs": "^7.0.0",
    "puppeteer": "^25.3.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
